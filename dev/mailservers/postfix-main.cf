# Development only: never deliver to the real internet. Mail for the test domains
# (dovecot.test) is delivered locally as usual; everything else goes to the Mailpit
# catcher (web inbox at http://localhost:8025). relayhost is the only next hop: if
# Mailpit is down, outside mail waits in the queue and is never sent directly.
relayhost = [mailpit]:1025
default_transport = smtp
relay_transport = smtp
smtp_tls_security_level = none
