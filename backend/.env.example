# Copy to .env (never commit it) or set these in your process manager / Docker secrets.
NODE_ENV=development
PORT=3000

# PostgreSQL. The API connects as the least-privilege runtime role (always subject to
# row-level security); migrations and tenant creation use the schema owner.
DATABASE_URL=postgres://foxalora_app:CHANGE_ME@127.0.0.1:55432/foxalora
DATABASE_OWNER_URL=postgres://foxalora:CHANGE_ME@127.0.0.1:55432/foxalora

# Valkey (or Redis): session vault, login throttling. A password is required in production.
VALKEY_URL=redis://:CHANGE_ME@127.0.0.1:6379

# Vault keys: "id:base64key" list, first one encrypts (32 bytes each: openssl rand -base64 32).
# Rotation: docs/runbooks/key-rotation.md
FOXALORA_VAULT_KEYS=v1:CHANGE_ME
# Master keys for envelope encryption of sensitive configuration (same format).
FOXALORA_MASTER_KEYS=m1:CHANGE_ME

SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# Login throttling (no account lockout: growing delay, hard block only per IP)
LOGIN_WINDOW_MINUTES=15
LOGIN_IP_MAX_FAILURES=50
LOGIN_FREE_FAILURES=3
LOGIN_DELAY_BASE_MS=500
LOGIN_DELAY_MAX_MS=8000
LOGIN_MIN_FAILURE_MS=1200

# Proxies whose X-Forwarded-For is trusted (Express syntax). Default fits Nginx in Docker.
TRUST_PROXY=loopback,uniquelocal
# Host names the API answers to (comma-separated). Set this in production.
ALLOWED_HOSTS=

# Size caps for reading mail
MAIL_MAX_TEXT_BYTES=2097152
MAIL_MAX_ATTACHMENT_BYTES=52428800
